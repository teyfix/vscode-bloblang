{
  "name": "vscode-bloblang",
  "displayName": "Bloblang",
  "version": "0.1.0",
  "description": "Bloblang language support for VS Code",
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "Benthos",
    "Bloblang",
    "Redpanda Connect"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/teyfix/vscode-bloblang"
  },
  "license": "MIT",
  "author": "Halil Teyfik Dolmaci",
  "publisher": "teyfix",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "bun run grammars && bun scripts/build.ts",
    "build:min": "bun run build -- --minify",
    "build:watch": "bun run build -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts test package.json language-configuration.json",
    "grammars": "bun scripts/generate-grammars.ts",
    "test": "bun test",
    "check": "bun run grammars && bun run typecheck && bun run lint && bun test",
    "bundle:server": "bun scripts/bundle-server.ts",
    "package": "bun run schema && bun run check && bun run bundle:server && bun run build:min && bun scripts/package.ts",
    "build:smoke": "bun build test/extension-host.ts --outfile dist/smoke.cjs --format cjs --target node --external vscode",
    "schema": "bun scripts/generate-schema.ts"
  },
  "contributes": {
    "commands": [
      {
        "command": "bloblang.restartServer",
        "title": "Bloblang: Restart Language Server"
      },
      {
        "command": "bloblang.showLogs",
        "title": "Bloblang: Show Language Server Logs"
      },
      {
        "command": "bloblang.formatEmbeddedMappings",
        "title": "Bloblang: Format Embedded Mappings",
        "enablement": "editorLangId == yaml"
      }
    ],
    "languages": [
      {
        "id": "bloblang",
        "aliases": [
          "Bloblang",
          "bloblang"
        ],
        "extensions": [
          ".blobl",
          ".bloblang"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bloblang",
        "scopeName": "source.bloblang.teyfix",
        "path": "./syntaxes/bloblang.tmLanguage.json"
      },
      {
        "scopeName": "bloblang.injection.yaml",
        "path": "./syntaxes/bloblang-yaml.tmLanguage.json",
        "injectTo": [
          "source.yaml",
          "source.yaml.1.2",
          "source.yaml.1.1",
          "source.yaml.1.3"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bloblang": "bloblang",
          "meta.embedded.inline.bloblang": "bloblang"
        }
      },
      {
        "scopeName": "bloblang.injection.cue",
        "path": "./syntaxes/bloblang-cue.tmLanguage.json",
        "injectTo": [
          "source.cue"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bloblang": "bloblang",
          "meta.embedded.inline.bloblang": "bloblang"
        }
      }
    ],
    "configuration": {
      "title": "Bloblang",
      "properties": {
        "bloblang.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Path or PATH command for bloblang-lsp. Empty uses the bundled server. Supports ${workspaceFolder} and ${userHome}."
        },
        "bloblang.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to bloblang-lsp."
        },
        "bloblang.yaml.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Provide Bloblang diagnostics, hover, completion and formatting inside YAML mapping fields and interpolations."
        },
        "bloblang.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the Bloblang language server."
        }
      }
    },
    "configurationDefaults": {
      "[bloblang]": {
        "editor.defaultFormatter": "teyfix.vscode-bloblang",
        "editor.insertSpaces": true,
        "editor.tabSize": 2
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.bloblangrc.json"
        ],
        "url": "./schemas/bloblangrc.schema.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:bloblang",
    "onLanguage:yaml"
  ],
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vscode-languageclient": "^9.0.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "icon.png"
}
