{
  "name": "vscode-bloblang",
  "displayName": "Bloblang",
  "version": "0.0.5",
  "description": "Bloblang language support for VS Code",
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers",
    "Snippets"
  ],
  "keywords": [
    "Benthos",
    "Bloblang",
    "Redpanda Connect"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/teyfix/vscode-bloblang"
  },
  "license": "MIT",
  "author": "Halil Teyfik Dolmaci",
  "publisher": "teyfix",
  "main": "./dist/extension",
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/extension.js --format cjs --target node --external vscode --external @aws-sdk/client-s3",
    "build:min": "bun run build -- --minify",
    "build:watch": "bun run build -- --watch",
    "prepackage": "bun run build:min",
    "package": "vsce package"
  },
  "contributes": {
    "commands": [
      {
        "command": "bloblang.restartServer",
        "title": "Bloblang: Restart Language Server"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:plaintext"
  ],
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "@types/unzipper": "^0.10.11",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "tar": "^7.5.15",
    "typescript": "^5",
    "unzipper": "^0.12.3",
    "vscode-languageclient": "^9.0.1"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "icon.png"
}
